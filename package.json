{
  "name": "talus-watchdog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Synthetic monitoring + public status page for Talus Ship (Cloudflare Worker on cron, backed by D1).",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create watchdog-db",
    "migrate:local": "wrangler d1 migrations apply watchdog-db --local",
    "migrate:remote": "wrangler d1 migrations apply watchdog-db --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.0.0",
    "wrangler": "^4.0.0"
  }
}
